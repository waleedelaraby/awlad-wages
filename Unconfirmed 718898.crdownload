// خدمة بسيطة: بتخلي المتصفح يعتبر الصفحة تطبيق. مفيش تخزين مؤقت عشان الأرقام تفضل حيّة ودايماً أحدث نسخة.
self.addEventListener('install', function () { self.skipWaiting(); });
self.addEventListener('activate', function (e) { e.waitUntil(self.clients.claim()); });
self.addEventListener('fetch', function () { /* الشبكة مباشرة */ });
